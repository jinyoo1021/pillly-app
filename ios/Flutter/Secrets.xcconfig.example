// Copy this file to `Secrets.xcconfig` and fill in real values locally.
// Secrets.xcconfig is gitignored.
//
// REVERSED_CLIENT_ID is taken from ios/Runner/GoogleService-Info.plist
// (the REVERSED_CLIENT_ID key). It is used as an OAuth URL scheme in
// Info.plist for Google Sign-In.
REVERSED_CLIENT_ID=com.googleusercontent.apps.YOUR_SENDER_ID-YOUR_HASH
